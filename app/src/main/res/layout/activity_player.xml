<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="150dp"
        android:layout_height="100dp"
        android:layout_gravity="bottom|end"
        android:layout_marginBottom="65dp"
        android:layout_marginEnd="18dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:visibility="visible"
        android:contentDescription="HICHRAWI"
        android:elevation="50dp"
        android:translationZ="50dp" />

    <TextView
        android:id="@+id/playerBack"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="18dp"
        android:layout_marginStart="18dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:background="#AA000000"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="رجوع" />

    <Button
        android:id="@+id/playerExit"
        android:layout_width="82dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="18dp"
        android:layout_marginStart="78dp"
        android:text="EXIT"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:background="#AA000000"
        android:elevation="60dp"
        android:translationZ="60dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone"
        android:contentDescription="EXIT" />

    <TextView
        android:id="@+id/playerMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="25dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#99000000"
        android:padding="12dp" />
</FrameLayout>
