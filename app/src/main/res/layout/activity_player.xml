<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:keepScreenOn="true" />

    <!-- HICHRAWI channel logo: top-right over the broadcast logo area -->
    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="110dp"
        android:layout_height="64dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:adjustViewBounds="true"
        android:scaleType="centerInside"
        android:visibility="gone"
        android:contentDescription="HICHRAWI" />

    <!-- Always-visible back button -->
    <TextView
        android:id="@+id/playerBack"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_marginTop="18dp"
        android:layout_marginStart="18dp"
        android:gravity="center"
        android:text="‹"
        android:textColor="#FFFFFF"
        android:textSize="40sp"
        android:textStyle="bold"
        android:background="#AA000000"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="رجوع" />

    <TextView
        android:id="@+id/playerMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="25dp"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="#99000000"
        android:padding="12dp" />
</FrameLayout>
